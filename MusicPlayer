package ui;

import service.AudioPlayer;

import javax.swing.*;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.io.File;
import java.util.ArrayList;
import java.util.Collections;

public class MusicPlayerFrame extends JFrame {

    // =========================================
    // BUTTONS
    // =========================================

    private JButton importButton;
    private JButton playButton;
    private JButton pauseButton;
    private JButton resumeButton;
    private JButton stopButton;

    private JButton previousButton;
    private JButton nextButton;

    private JButton removeButton;

    private JButton shuffleButton;
    private JButton repeatButton;

    private JButton onlinePlayButton;

    // =========================================
    // UI
    // =========================================

    private JLabel currentSongLabel;
    private JLabel statusLabel;

    private JTextField searchField;
    private JTextField onlineUrlField;

    private JList<String> songList;

    private DefaultListModel<String> listModel;

    // =========================================
    // DATA
    // =========================================

    private ArrayList<File> musicFiles;

    private ArrayList<File> originalMusicFiles;

    private AudioPlayer audioPlayer;

    private int currentIndex = -1;

    private boolean shuffle = false;
    private boolean repeat = false;

    // =========================================
    // CONSTRUCTOR
    // =========================================

    public MusicPlayerFrame() {

        setTitle("🎵 Music Player");

        setSize(1000, 600);

        setDefaultCloseOperation(
                JFrame.EXIT_ON_CLOSE
        );

        setLocationRelativeTo(null);

        musicFiles = new ArrayList<>();

        originalMusicFiles = new ArrayList<>();

        audioPlayer = new AudioPlayer();

        createUI();
    }

    // =========================================
    // CREATE UI
    // =========================================

    private void createUI() {

        JPanel mainPanel =
                new JPanel(
                        new BorderLayout(10, 10)
                );

        mainPanel.setBorder(
                BorderFactory.createEmptyBorder(
                        10, 10, 10, 10
                )
        );

        // =====================================
        // LEFT PANEL
        // =====================================

        JPanel leftPanel =
                new JPanel(
                        new BorderLayout(5, 5)
                );

        JLabel libraryLabel =
                new JLabel("🎵 Music Library");

        libraryLabel.setHorizontalAlignment(
                SwingConstants.CENTER
        );

        libraryLabel.setFont(
                new Font(
                        "Segoe UI",
                        Font.BOLD,
                        22
                )
        );

        leftPanel.add(
                libraryLabel,
                BorderLayout.NORTH
        );

        // =====================================
        // SEARCH
        // =====================================

        searchField =
                new JTextField();

        searchField.setToolTipText(
                "Search local songs"
        );

        JPanel searchPanel =
                new JPanel(
                        new BorderLayout(5, 5)
                );

        searchPanel.setBorder(
                BorderFactory.createEmptyBorder(
                        5, 0, 5, 0
                )
        );

        searchPanel.add(
                new JLabel("🔎 "),
                BorderLayout.WEST
        );

        searchPanel.add(
                searchField,
                BorderLayout.CENTER
        );

        leftPanel.add(
                searchPanel,
                BorderLayout.NORTH
        );

        // =====================================
        // SONG LIST
        // =====================================

        listModel =
                new DefaultListModel<>();

        songList =
                new JList<>(listModel);

        songList.setFont(
                new Font(
                        "Segoe UI",
                        Font.PLAIN,
                        15
                )
        );

        songList.setSelectionMode(
                ListSelectionModel.SINGLE_SELECTION
        );

        JScrollPane scrollPane =
                new JScrollPane(songList);

        leftPanel.add(
                scrollPane,
                BorderLayout.CENTER
        );

        // =====================================
        // LEFT BUTTONS
        // =====================================

        JPanel leftButtons =
                new JPanel(
                        new GridLayout(1, 2, 5, 5)
                );

        importButton =
                new JButton("📁 Import");

        removeButton =
                new JButton("🗑 Remove");

        leftButtons.add(importButton);
        leftButtons.add(removeButton);

        leftPanel.add(
                leftButtons,
                BorderLayout.SOUTH
        );

        // =====================================
        // CENTER PANEL
        // =====================================

        JPanel centerPanel =
                new JPanel(
                        new BorderLayout(10, 10)
                );

        // =====================================
        // NOW PLAYING
        // =====================================

        currentSongLabel =
                new JLabel(
                        "No song selected",
                        SwingConstants.CENTER
                );

        currentSongLabel.setFont(
                new Font(
                        "Segoe UI",
                        Font.BOLD,
                        25
                )
        );

        centerPanel.add(
                currentSongLabel,
                BorderLayout.NORTH
        );

        // =====================================
        // CENTER CONTENT
        // =====================================

        JPanel contentPanel =
                new JPanel();

        contentPanel.setLayout(
                new BoxLayout(
                        contentPanel,
                        BoxLayout.Y_AXIS
                )
        );

        // =====================================
        // ONLINE MUSIC
        // =====================================

        JPanel onlinePanel =
                new JPanel(
                        new FlowLayout(
                                FlowLayout.CENTER,
                                8,
                                10
                        )
                );

        JLabel onlineLabel =
                new JLabel("🌐 Online MP3 URL:");

        onlineUrlField =
                new JTextField(32);

        onlinePlayButton =
                new JButton("▶ Play Online");

        onlinePanel.add(onlineLabel);
        onlinePanel.add(onlineUrlField);
        onlinePanel.add(onlinePlayButton);

        contentPanel.add(onlinePanel);

        // =====================================
        // ONLINE INFO
        // =====================================

        JLabel onlineInfo =
                new JLabel(
                        "Enter a direct .mp3 audio URL"
                );

        onlineInfo.setAlignmentX(
                Component.CENTER_ALIGNMENT
        );

        contentPanel.add(onlineInfo);

        contentPanel.add(
                Box.createVerticalStrut(40)
        );

        // =====================================
        // CONTROL PANEL
        // =====================================

        JPanel controlPanel =
                new JPanel(
                        new FlowLayout(
                                FlowLayout.CENTER,
                                8,
                                10
                        )
                );

        previousButton =
                new JButton("⏮ Previous");

        playButton =
                new JButton("▶ Play");

        pauseButton =
                new JButton("⏸ Pause");

        resumeButton =
                new JButton("▶ Resume");

        stopButton =
                new JButton("⏹ Stop");

        nextButton =
                new JButton("Next ⏭");

        controlPanel.add(previousButton);
        controlPanel.add(playButton);
        controlPanel.add(pauseButton);
        controlPanel.add(resumeButton);
        controlPanel.add(stopButton);
        controlPanel.add(nextButton);

        contentPanel.add(controlPanel);

        // =====================================
        // EXTRA CONTROLS
        // =====================================

        JPanel extraPanel =
                new JPanel(
                        new FlowLayout(
                                FlowLayout.CENTER,
                                15,
                                10
                        )
                );

        shuffleButton =
                new JButton("🔀 Shuffle OFF");

        repeatButton =
                new JButton("🔁 Repeat OFF");

        extraPanel.add(shuffleButton);
        extraPanel.add(repeatButton);

        contentPanel.add(extraPanel);

        contentPanel.add(
                Box.createVerticalStrut(30)
        );

        // =====================================
        // STATUS
        // =====================================

        statusLabel =
                new JLabel(
                        "Ready",
                        SwingConstants.CENTER
                );

        statusLabel.setFont(
                new Font(
                        "Segoe UI",
                        Font.PLAIN,
                        16
                )
        );

        contentPanel.add(statusLabel);

        centerPanel.add(
                contentPanel,
                BorderLayout.CENTER
        );

        // =====================================
        // BUTTON EVENTS
        // =====================================

        importButton.addActionListener(
                e -> importMusic()
        );

        removeButton.addActionListener(
                e -> removeSong()
        );

        playButton.addActionListener(
                e -> playMusic()
        );

        pauseButton.addActionListener(
                e -> pauseMusic()
        );

        resumeButton.addActionListener(
                e -> resumeMusic()
        );

        stopButton.addActionListener(
                e -> stopMusic()
        );

        previousButton.addActionListener(
                e -> previousMusic()
        );

        nextButton.addActionListener(
                e -> nextMusic()
        );

        onlinePlayButton.addActionListener(
                e -> playOnlineMusic()
        );

        shuffleButton.addActionListener(
                e -> toggleShuffle()
        );

        repeatButton.addActionListener(
                e -> toggleRepeat()
        );

        // =====================================
        // SEARCH EVENT
        // =====================================

        searchField
                .getDocument()
                .addDocumentListener(
                        new DocumentListener() {

                            public void insertUpdate(
                                    DocumentEvent e
                            ) {
                                searchSongs();
                            }

                            public void removeUpdate(
                                    DocumentEvent e
                            ) {
                                searchSongs();
                            }

                            public void changedUpdate(
                                    DocumentEvent e
                            ) {
                                searchSongs();
                            }
                        }
                );

        // =====================================
        // SONG SELECT
        // =====================================

        songList.addListSelectionListener(
                e -> {

                    if (!e.getValueIsAdjusting()) {

                        int index =
                                songList.getSelectedIndex();

                        if (index >= 0 &&
                                index < musicFiles.size()) {

                            currentIndex = index;

                            currentSongLabel.setText(
                                    musicFiles
                                            .get(index)
                                            .getName()
                            );

                            statusLabel.setText(
                                    "Song selected"
                            );
                        }
                    }
                }
        );

        // =====================================
        // DOUBLE CLICK
        // =====================================

        songList.addMouseListener(
                new MouseAdapter() {

                    @Override
                    public void mouseClicked(
                            MouseEvent e
                    ) {

                        if (e.getClickCount() == 2) {

                            playMusic();
                        }
                    }
                }
        );

        // =====================================
        // SPLIT PANE
        // =====================================

        JSplitPane splitPane =
                new JSplitPane(
                        JSplitPane.HORIZONTAL_SPLIT,
                        leftPanel,
                        centerPanel
                );

        splitPane.setDividerLocation(350);

        splitPane.setResizeWeight(0.30);

        mainPanel.add(
                splitPane,
                BorderLayout.CENTER
        );

        add(mainPanel);
    }

    // =========================================
    // IMPORT MUSIC
    // =========================================

    private void importMusic() {

        JFileChooser chooser =
                new JFileChooser();

        chooser.setMultiSelectionEnabled(true);

        int result =
                chooser.showOpenDialog(this);

        if (result ==
                JFileChooser.APPROVE_OPTION) {

            File[] files =
                    chooser.getSelectedFiles();

            for (File file : files) {

                String name =
                        file.getName()
                                .toLowerCase();

                if (name.endsWith(".mp3")) {

                    if (!musicFiles.contains(file)) {

                        musicFiles.add(file);

                        originalMusicFiles.add(file);
                    }

                } else {

                    JOptionPane.showMessageDialog(
                            this,
                            "Only MP3 files are supported.",
                            "Invalid File",
                            JOptionPane.WARNING_MESSAGE
                    );
                }
            }

            refreshList();

            statusLabel.setText(
                    "Music imported successfully"
            );
        }
    }

    // =========================================
    // REFRESH LIST
    // =========================================

    private void refreshList() {

        listModel.clear();

        for (File file : musicFiles) {

            listModel.addElement(
                    file.getName()
            );
        }
    }

    // =========================================
    // SEARCH
    // =========================================

    private void searchSongs() {

        String search =
                searchField
                        .getText()
                        .trim()
                        .toLowerCase();

        musicFiles.clear();

        if (search.isEmpty()) {

            musicFiles.addAll(
                    originalMusicFiles
            );

        } else {

            for (File file :
                    originalMusicFiles) {

                if (file.getName()
                        .toLowerCase()
                        .contains(search)) {

                    musicFiles.add(file);
                }
            }
        }

        refreshList();

        currentIndex = -1;
    }

    // =========================================
    // REMOVE SONG
    // =========================================

    private void removeSong() {

        int index =
                songList.getSelectedIndex();

        if (index == -1) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please select a song."
            );

            return;
        }

        File file =
                musicFiles.get(index);

        int result =
                JOptionPane.showConfirmDialog(
                        this,
                        "Remove this song from library?",
                        "Confirm",
                        JOptionPane.YES_NO_OPTION
                );

        if (result ==
                JOptionPane.YES_OPTION) {

            musicFiles.remove(file);

            originalMusicFiles.remove(file);

            refreshList();

            currentIndex = -1;

            currentSongLabel.setText(
                    "No song selected"
            );

            statusLabel.setText(
                    "Song removed"
            );
        }
    }

    // =========================================
    // PLAY MUSIC
    // =========================================

    private void playMusic() {

        int index =
                songList.getSelectedIndex();

        if (index == -1) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please select a song first."
            );

            return;
        }

        currentIndex = index;

        File file =
                musicFiles.get(index);

        currentSongLabel.setText(
                "▶ " + file.getName()
        );

        statusLabel.setText(
                "Playing..."
        );

        audioPlayer.play(
                file.getAbsolutePath()
        );
    }

    // =========================================
    // PLAY ONLINE
    // =========================================

    private void playOnlineMusic() {

        String url =
                onlineUrlField
                        .getText()
                        .trim();

        if (url.isEmpty()) {

            JOptionPane.showMessageDialog(
                    this,
                    "Please enter a direct MP3 URL."
            );

            return;
        }

        if (!url.startsWith("http://") &&
                !url.startsWith("https://")) {

            JOptionPane.showMessageDialog(
                    this,
                    "URL must start with http:// or https://"
            );

            return;
        }

        currentSongLabel.setText(
                "🌐 Online Music"
        );

        statusLabel.setText(
                "Connecting to online music..."
        );

        audioPlayer.playOnline(url);
    }

    // =========================================
    // PAUSE
    // =========================================

    private void pauseMusic() {

        audioPlayer.pause();

        currentSongLabel.setText(
                "⏸ Music Paused"
        );

        statusLabel.setText(
                "Paused"
        );
    }

    // =========================================
    // RESUME
    // =========================================

    private void resumeMusic() {

        audioPlayer.resume();

        currentSongLabel.setText(
                "▶ Music Resumed"
        );

        statusLabel.setText(
                "Playing..."
        );
    }

    // =========================================
    // STOP
    // =========================================

    private void stopMusic() {

        audioPlayer.stop();

        currentSongLabel.setText(
                "⏹ Music Stopped"
        );

        statusLabel.setText(
                "Stopped"
        );
    }

    // =========================================
    // PREVIOUS
    // =========================================

    private void previousMusic() {

        if (musicFiles.isEmpty()) {

            return;
        }

        if (currentIndex <= 0) {

            currentIndex =
                    musicFiles.size() - 1;

        } else {

            currentIndex--;
        }

        songList.setSelectedIndex(
                currentIndex
        );

        playSelectedSong();
    }

    // =========================================
    // NEXT
    // =========================================

    private void nextMusic() {

        if (musicFiles.isEmpty()) {

            return;
        }

        if (shuffle) {

            currentIndex =
                    (int) (
                            Math.random()
                                    * musicFiles.size()
                    );

        } else {

            currentIndex++;

            if (currentIndex >=
                    musicFiles.size()) {

                if (repeat) {

                    currentIndex = 0;

                } else {

                    currentIndex = 0;
                }
            }
        }

        songList.setSelectedIndex(
                currentIndex
        );

        playSelectedSong();
    }

    // =========================================
    // PLAY SELECTED
    // =========================================

    private void playSelectedSong() {

        if (currentIndex < 0 ||
                currentIndex >= musicFiles.size()) {

            return;
        }

        File file =
                musicFiles.get(currentIndex);

        currentSongLabel.setText(
                "▶ " + file.getName()
        );

        statusLabel.setText(
                "Playing..."
        );

        audioPlayer.play(
                file.getAbsolutePath()
        );
    }

    // =========================================
    // SHUFFLE
    // =========================================

    private void toggleShuffle() {

        shuffle = !shuffle;

        if (shuffle) {

            shuffleButton.setText(
                    "🔀 Shuffle ON"
            );

        } else {

            shuffleButton.setText(
                    "🔀 Shuffle OFF"
            );
        }
    }

    // =========================================
    // REPEAT
    // =========================================

    private void toggleRepeat() {

        repeat = !repeat;

        if (repeat) {

            repeatButton.setText(
                    "🔁 Repeat ON"
            );

        } else {

            repeatButton.setText(
                    "🔁 Repeat OFF"
            );
        }
    }
}
